# ─────────────────────────────────────────────────────────────
# AI Survival Kit — configuración
# Copia este archivo a `.env` y ajusta lo que quieras.
# ─────────────────────────────────────────────────────────────

# Puertos expuestos al host
OLLAMA_PORT=11434
WEBUI_PORT=3000

# Modelo que se descarga automáticamente la primera vez.
# Recomendaciones según hardware:
#   - CPU / 8GB RAM:           qwen2.5:3b      (~2 GB)
#   - 16GB RAM o GPU 6GB:      qwen2.5:7b      (~4.5 GB)
#   - GPU 12GB+:               qwen2.5:14b     (~9 GB)
#   - Coding:                  qwen2.5-coder:7b
#   - Multilingüe ligero:      llama3.2:3b
DEFAULT_MODEL=qwen2.5:3b

# Tiempo que el modelo permanece cargado en memoria tras la última petición.
OLLAMA_KEEP_ALIVE=5m

# Open WebUI
# WEBUI_AUTH=false  → desactiva login (solo recomendado en red local de confianza)
WEBUI_AUTH=true
ENABLE_SIGNUP=true
WEBUI_NAME=AI Survival Kit

# ─────────────────────────────────────────────────────────────
# Perfil CREATOR
# ─────────────────────────────────────────────────────────────

# ComfyUI — imagen y vídeo
COMFYUI_PORT=8188
# Argumentos extra para ComfyUI. Ejemplos útiles:
#   --lowvram          (GPU con poca VRAM)
#   --cpu              (forzar CPU, lento pero funciona sin GPU)
#   --listen 0.0.0.0   (ya viene activado por defecto en la imagen)
COMFYUI_CLI_ARGS=

# Whisper (transcripción) — API compatible con OpenAI en /v1/audio/transcriptions
WHISPER_PORT=8001
# Modelos disponibles (tamaño aprox. del modelo en disco):
#   Systran/faster-whisper-tiny       (~75 MB)
#   Systran/faster-whisper-base       (~145 MB)
#   Systran/faster-whisper-small      (~480 MB)   ← buen equilibrio
#   Systran/faster-whisper-medium     (~1.5 GB)
#   Systran/faster-whisper-large-v3   (~3 GB)     ← máxima calidad
WHISPER_MODEL=Systran/faster-whisper-small
# CPU: int8 (rápido). GPU: float16 o float32.
WHISPER_COMPUTE_TYPE=int8

# Kokoro TTS (voz sintética) — API compatible con OpenAI en /v1/audio/speech
KOKORO_PORT=8002

# ─────────────────────────────────────────────────────────────
# Perfil BUNKER
# ─────────────────────────────────────────────────────────────

# LiteLLM — proxy unificado compatible con OpenAI
# Endpoint: http://localhost:4000/v1
LITELLM_PORT=4000
LITELLM_LOG=INFO
